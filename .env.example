# This file is a map, not an application-loaded environment file.
# Web: copy apps/web/.env.example to apps/web/.env.local.
# Worker: copy apps/worker/.env.example to apps/worker/.env.
# Local database: pnpm db:start && pnpm setup:local (creates ignored local credentials).
# Optional CLI override for package builds:
SUBSTREAMS_BIN=substreams
# Credential-gated smoke: supply worker variables to the process; see docs/UNISWAP-INTEGRATION.md.
REQUIRE_LIVE=0
# Sending an external test also requires both explicit values below:
SCOUT_ALLOW_TELEGRAM_TEST=0
SCOUT_TELEGRAM_TEST_CHAT_ID=

# Email alert credentials belong in web/worker templates above, not this file.
# Email test sends are explicitly requested from Connections for the verified destination.
# Automated email tests use controlled HTTP responses and never send public mail.

# Privy sign-in: configure NEXT_PUBLIC_PRIVY_APP_ID and PRIVY_APP_SECRET in
# apps/web/.env.local. See docs/AUTHENTICATION.md. Local setup does not fake login.
