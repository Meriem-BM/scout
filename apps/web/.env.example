# PUBLIC: Privy Dashboard. Email + Google login; wallet is optional.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional app client ID when configured in Privy.
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# SERVER ONLY: Privy app secret. Never expose in client bundles.
PRIVY_APP_SECRET=
# Optional PEM verification key; omit for Privy JWKS. Escaped \n is supported.
PRIVY_VERIFICATION_KEY=

# PUBLIC: Supabase Project Settings > API. Scout authorizes through its server gateway.
# https://supabase.com/docs/guides/api/api-keys
NEXT_PUBLIC_SUPABASE_URL=
# SERVER ONLY: never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SCOUT_SITE_URL=http://localhost:3000
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# https://thegraph.com/studio/ > API keys (separate from the Substreams data-plane key)
GRAPH_API_KEY=
GRAPH_SUBGRAPH_ID=5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV
# Ethereum mainnet RPC supporting historical eth_call/getCode, finalized blocks, simulation.
ETHEREUM_RPC_URL=
# https://developers.uniswap.org/dashboard/ > Trading API key
UNISWAP_API_KEY=
# https://core.telegram.org/bots/tutorial > @BotFather; username has no @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random secret: use the same value in Telegram setWebhook.secret_token.
TELEGRAM_WEBHOOK_SECRET=

# SERVER ONLY: Resend alert email, separate from Privy sign-in.
# https://resend.com/docs/dashboard/domains/introduction
RESEND_API_KEY=
# A sender at your verified domain, e.g. Scout <alerts@your-domain.example>
RESEND_FROM_EMAIL=
# Signing secret for the Resend webhook registered at /api/email/webhook.
RESEND_WEBHOOK_SECRET=
# Random 32+ character HMAC secret, identical on web and worker.
EMAIL_LINK_SECRET=
