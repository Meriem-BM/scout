# SERVER ONLY. Use Supabase direct (IPv6) or session pooler (IPv4), port 5432, SSL.
# `pnpm setup:local` fills the local database and Supabase values automatically.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SCOUT_SITE_URL=http://localhost:3000

# Ethereum mainnet RPC supporting historical calls and finalized blocks.
ETHEREUM_RPC_URL=
# Base RPC must support finalized blocks, eth_getBlockReceipts and bounded eth_getLogs.
# Public endpoint for local verification; use a dedicated endpoint for sustained production traffic.
BASE_RPC_URL=https://base-rpc.publicnode.com
BASE_SUBSTREAMS_ENDPOINT=https://base-mainnet.streamingfast.io:443
# Global across all Scout workers using this database. One slot is reserved for verification.
# Match the actual provider account limit; capacity 2 permits only one live stream.
SUBSTREAMS_SESSION_CAPACITY=2

# The Graph Studio API key and the Uniswap Subgraph deployment ID.
GRAPH_API_KEY=
GRAPH_SUBGRAPH_ID=5zvR82QoaXYFyDEKLZ9t6v9adgnptxYpKpSbxtgVENFV

# The Graph Market Substreams data-plane API key. This is distinct from GRAPH_API_KEY;
# current keys use a provider-issued mobile/server/web/worker/hosted prefix.
SUBSTREAMS_API_KEY=
# Alternatively use a current bearer token. Omit unused entries instead of setting them empty.
# SUBSTREAMS_API_TOKEN=
SUBSTREAMS_ENDPOINT=https://mainnet.eth.streamingfast.io:443
SUBSTREAMS_BIN=substreams
SUBSTREAMS_TEMPLATE_DIR=../../substreams

# Required for natural-language intent resolution and planning.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Alert email is independent from Privy authentication email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Random 32+ character HMAC secret, identical on web and worker.
EMAIL_LINK_SECRET=

# Optional Telegram alert delivery.
TELEGRAM_BOT_TOKEN=

PORT=8080
